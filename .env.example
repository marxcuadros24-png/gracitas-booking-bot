# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_TIMEZONE=America/Lima

# PostgreSQL
DATABASE_URL=postgresql://booking_user:booking_pass@localhost:5432/booking_db
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=booking_pass
POSTGRES_DB=booking_db

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=change-me-app-secret
WHATSAPP_ACCESS_TOKEN=change-me-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_REMINDER_NAME=booking_reminder
WHATSAPP_TEMPLATE_LANGUAGE=es

# LLM Provider (OpenAI-compatible: OpenAI, Gemini, Groq, etc.)
LLM_API_KEY=change-me-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOOL_ITERATIONS=3

# Admin Dashboard
ADMIN_TOKEN=change-me-admin-token
